# Copy to deploy/platform/.env (git-ignored) and replace every value. No real secret belongs in Git.
ATLAS_DB_PASSWORD=change-me-local-db-password
ATLAS_S3_ACCESS_KEY=atlas-local
ATLAS_S3_SECRET_KEY=change-me-local-minio-secret
# One-time bootstrap of the first system administrator (remove after first start)
ATLAS_BOOTSTRAP_ADMIN_EMAIL=admin@example.test
ATLAS_BOOTSTRAP_ADMIN_PASSWORD=change-me-strong-admin-password
# Container mode cannot reach host loopback models; run the jar natively (scripts/start-platform-dev.ps1) for full RAG.
ATLAS_MODELS_ENABLED=false
